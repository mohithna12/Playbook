# =============================================================================
# playbook-worker -- ARQ workers (general + simulation)
# Includes NumPy/SciPy for simulation, LLM SDK for explanations. ~420 MB.
# =============================================================================
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    OMP_NUM_THREADS=2

RUN groupadd --gid 1000 app && \
    useradd --uid 1000 --gid app --shell /bin/bash --create-home app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /home/app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --extra worker

COPY app/ app/

USER app

CMD ["uv", "run", "arq", "app.workers.config.WorkerSettings"]
