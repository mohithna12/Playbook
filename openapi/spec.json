            },
            "description": "Rate limit exceeded"
          },
          "500": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/problem+json": {}
            },
            "description": "A dependency the request needs is unavailable"
          }
        },
        "security": [
          {
            "ClerkJWT": []
          }
        ],
        "summary": "Cancel a job",
        "tags": [
          "jobs"
        ]
      },
