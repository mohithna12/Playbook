{
  "components": {
    "schemas": {
      "JobKind": {
        "description": "Every async job the system knows how to run.",
        "enum": [
          "echo",
          "league.full_import",
          "league.incremental_sync",
          "simulation.run",
          "trade.analyze",
          "explanation.generate",
          "cache.warm_league"
        ],
        "title": "JobKind",
        "type": "string"
      },
      "JobStatusResponse": {
        "description": "What ``GET /v1/jobs/{id}`` returns.\n\n``result_ref`` is a pointer, not the result: a reference to where the work\nlanded (a league id, a simulation id). Async endpoints return handles and\nclients fetch the real resource, so a job row never has to grow to hold a\npayload.",
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "deadline_at": {
            "format": "date-time",
            "title": "Deadline At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "progress_pct": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress Pct",
            "type": "integer"
          },
          "progress_step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress Step"
          },
          "result_ref": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Ref"
          },
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "PARTIAL",
              "CANCELLED"
            ],
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "progress_pct",
          "attempts",
          "created_at",
          "updated_at",
          "deadline_at"
        ],
        "title": "JobStatusResponse",
        "type": "object"
      },
      "ModelVersionSummary": {
        "description": "One active model and its headline evaluation metrics.",
        "properties": {
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Metrics",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "trained_at": {
            "format": "date-time",
            "title": "Trained At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "trained_at"
        ],
        "title": "ModelVersionSummary",
        "type": "object"
      },
      "NflState": {
        "description": "Where the NFL season currently is. Drives week defaults everywhere.",
        "properties": {
          "lock_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Kickoff of the first game of the current week; lineups lock per game.",
            "title": "Lock At"
          },
          "next_kickoff_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Kickoff At"
          },
          "season": {
            "title": "Season",
            "type": "integer"
          },
          "season_type": {
            "title": "Season Type",
            "type": "string"
          },
          "week": {
            "title": "Week",
            "type": "integer"
          }
        },
        "required": [
          "season",
          "week",
          "season_type"
        ],
        "title": "NflState",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ClerkJWT": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "ML-backed fantasy football decision copilot",
    "title": "Playbook",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "200 whenever the process is running. Checks nothing else, by design.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Missing or invalid credentials"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Rate limit exceeded"
          },
          "500": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/problem+json": {}
            },
            "description": "A dependency the request needs is unavailable"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "200 only when Postgres and Redis both answer.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Missing or invalid credentials"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Rate limit exceeded"
          },
          "500": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Internal error"
          },
          "503": {
            "description": "A dependency is unreachable; do not route traffic here."
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/jobs/{job_id}": {
      "delete": {
        "description": "Cancel a queued or running job.\n\nA queued job never starts. A running one stops at its handler's next\ncheckpoint -- cooperative rather than pre-emptive, so a job is not killed\nhalfway through a write.",
        "operationId": "cancel_job_v1_jobs__job_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
