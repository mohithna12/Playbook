{
  "components": {
    "schemas": {
      "ModelVersionSummary": {
        "description": "One active model and its headline evaluation metrics.",
        "properties": {
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Metrics",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "trained_at": {
            "format": "date-time",
            "title": "Trained At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "trained_at"
        ],
        "title": "ModelVersionSummary",
        "type": "object"
      },
      "NflState": {
        "description": "Where the NFL season currently is. Drives week defaults everywhere.",
        "properties": {
          "lock_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Kickoff of the first game of the current week; lineups lock per game.",
            "title": "Lock At"
          },
          "next_kickoff_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Kickoff At"
          },
          "season": {
            "title": "Season",
            "type": "integer"
          },
          "season_type": {
            "title": "Season Type",
            "type": "string"
          },
          "week": {
            "title": "Week",
            "type": "integer"
          }
        },
        "required": [
          "season",
          "week",
          "season_type"
        ],
        "title": "NflState",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "ML-backed fantasy football decision copilot",
    "title": "FantasyAI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "200 whenever the process is running. Checks nothing else, by design.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Missing or invalid credentials"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Rate limit exceeded"
          },
          "500": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Internal error"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "200 only when Postgres and Redis both answer.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Missing or invalid credentials"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Rate limit exceeded"
          },
          "500": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Internal error"
          },
          "503": {
            "description": "A dependency is unreachable; do not route traffic here."
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
