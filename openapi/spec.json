    "/v1/jobs/{job_id}/stream": {
      "get": {
        "description": "Progress events until the job reaches a terminal state.\n\n``X-Accel-Buffering: no`` matters as much as the content type: a buffering\nproxy will happily hold an event stream until it has \"enough\" to send,\nwhich turns real-time progress into one burst at the end.",
        "operationId": "stream_job_v1_jobs__job_id__stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
