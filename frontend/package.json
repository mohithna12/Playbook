{
  "name": "playbook-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../openapi/spec.json -o src/lib/api/types.ts"
  },
  "dependencies": {
    "next": "^15.1",
    "react": "^19.0",
    "react-dom": "^19.0",
    "@clerk/nextjs": "^6",
    "@tanstack/react-query": "^5",
    "recharts": "^2.13",
    "zustand": "^5",
    "openapi-fetch": "^0.12"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^22",
    "tailwindcss": "^3.4",
    "postcss": "^8",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^15.1",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "vitest": "^2",
    "@testing-library/react": "^16",
    "@playwright/test": "^1.49",
    "openapi-typescript": "^7"
  }
}
