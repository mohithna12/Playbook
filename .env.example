# =============================================================================
# FantasyAI -- Environment Variables
# =============================================================================
# Copy to .env:  cp .env.example .env
# Start services: make docker-up
# Run the app:    make run
#
# Development costs $0. Everything runs locally via Docker.
# No AWS account needed for development.
# =============================================================================

# -- Application --
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
SERVICE_VERSION=0.1.0
# Comma-separated origins for the browser client. Empty disables CORS, which is
# correct behind the ALB where the frontend is same-origin.
CORS_ALLOW_ORIGINS=http://localhost:3000

# -- Telemetry --
# Traces export only when OTEL_EXPORTER_OTLP_ENDPOINT is set; the SDK is always
# installed so trace_id exists in logs and error responses regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Head sampling ratio, production only. Non-production samples everything.
OTEL_SAMPLE_RATIO=0.1

# -- Database (local Postgres from docker-compose) --
DATABASE_URL=postgresql+asyncpg://fantasyai:fantasyai@localhost:5432/fantasyai
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=3
DATABASE_STATEMENT_TIMEOUT_MS=5000

# -- Redis (local Redis from docker-compose) --
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_DB=1
REDIS_RATE_LIMIT_DB=2
REDIS_LOCK_DB=3
REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# -- Auth (Clerk) --
# Free tier: https://clerk.com — sign up and paste your dev keys.
# Empty is allowed in development and staging; a production deploy refuses to
# start without all three, rather than booting unable to verify tokens.
# CLERK_AUDIENCE is the `azp` claim; when empty, audience is not verified.
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

# -- AWS / S3 --
# Not needed for development. S3 operations are skipped in dev mode.
# To test S3 locally: docker compose --profile s3 up -d
# Then set: S3_ENDPOINT_URL=http://localhost:4566
S3_ENDPOINT_URL=
AWS_REGION=us-west-2
S3_RAW_BUCKET=fantasyai-raw
S3_MODELS_BUCKET=fantasyai-models
S3_FEATURES_BUCKET=fantasyai-features

# -- External APIs --
# Sleeper API: no key needed (free, public)
# Odds API: free tier gives 500 req/month — optional for dev
ODDS_API_KEY=

# -- LLM (only needed for the explanation feature) --
# Leave empty to use deterministic template fallback in dev
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_DAILY_SPEND_CAP_USD=1.00

# -- Simulation --
DEFAULT_N_SIMULATIONS=10000
MAX_N_SIMULATIONS=50000

# -- Rate Limiting --
RATE_LIMIT_READS_PER_MIN=120
RATE_LIMIT_WRITES_PER_MIN=20
RATE_LIMIT_EXPLAIN_PER_MIN=10

# -- Testing --
# Point the integration and contract suites at an already-running server
# instead of spinning up testcontainers. For machines without a Docker daemon.
# The named database is dropped and rebuilt from scratch -- never aim these at
# anything you care about.
TEST_DATABASE_URL=
TEST_REDIS_URL=
