# =============================================================================
# FantasyAI -- Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -- Application --
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG                   # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# -- Database --
DATABASE_URL=postgresql+asyncpg://fantasyai:fantasyai@localhost:5432/fantasyai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=5000

# -- Redis --
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_DB=1
REDIS_RATE_LIMIT_DB=2
REDIS_LOCK_DB=3

# -- Auth (Clerk) --
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=                   # Optional: set if using azp claim

# -- AWS --
AWS_REGION=us-west-2
S3_RAW_BUCKET=fantasyai-raw
S3_MODELS_BUCKET=fantasyai-models
S3_FEATURES_BUCKET=fantasyai-features
# AWS credentials come from IRSA in production; locally use AWS_PROFILE or keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -- External APIs --
ODDS_API_KEY=                     # From https://the-odds-api.com
# Sleeper API requires no auth

# -- LLM --
ANTHROPIC_API_KEY=                # From https://console.anthropic.com
LLM_MODEL=claude-sonnet-4-5-20241022
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_DAILY_SPEND_CAP_USD=5.00

# -- Simulation --
DEFAULT_N_SIMULATIONS=50000
MAX_N_SIMULATIONS=100000

# -- Rate Limiting --
RATE_LIMIT_READS_PER_MIN=120
RATE_LIMIT_WRITES_PER_MIN=20
RATE_LIMIT_EXPLAIN_PER_MIN=10
