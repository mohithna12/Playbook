# =============================================================================
# FantasyAI -- Environment Variables
# =============================================================================
# Copy to .env:  cp .env.example .env
# Start services: make docker-up
# Run the app:    make run
#
# Development costs $0. Everything runs locally via Docker.
# No AWS account needed for development.
# =============================================================================

# -- Application --
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# -- Database (local Postgres from docker-compose) --
DATABASE_URL=postgresql+asyncpg://fantasyai:fantasyai@localhost:5432/fantasyai
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=3
DATABASE_STATEMENT_TIMEOUT_MS=5000

# -- Redis (local Redis from docker-compose) --
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_DB=1
REDIS_RATE_LIMIT_DB=2
REDIS_LOCK_DB=3

# -- Auth (Clerk) --
# Free tier: https://clerk.com — sign up and paste your dev keys
# Leave empty to disable auth in development (endpoints will be open)
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

# -- AWS / S3 --
# Not needed for development. S3 operations are skipped in dev mode.
# To test S3 locally: docker compose --profile s3 up -d
# Then set: S3_ENDPOINT_URL=http://localhost:4566
S3_ENDPOINT_URL=
AWS_REGION=us-west-2
S3_RAW_BUCKET=fantasyai-raw
S3_MODELS_BUCKET=fantasyai-models
S3_FEATURES_BUCKET=fantasyai-features

# -- External APIs --
# Sleeper API: no key needed (free, public)
# Odds API: free tier gives 500 req/month — optional for dev
ODDS_API_KEY=

# -- LLM (only needed for the explanation feature) --
# Leave empty to use deterministic template fallback in dev
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20241022
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_DAILY_SPEND_CAP_USD=1.00

# -- Simulation --
DEFAULT_N_SIMULATIONS=10000
MAX_N_SIMULATIONS=50000

# -- Rate Limiting --
RATE_LIMIT_READS_PER_MIN=120
RATE_LIMIT_WRITES_PER_MIN=20
RATE_LIMIT_EXPLAIN_PER_MIN=10
